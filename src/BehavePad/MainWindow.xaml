<Window x:Class="BehavePad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:branding="clr-namespace:BehavePad.Branding"
        xmlns:controls="clr-namespace:BehavePad.Controls"
        xmlns:vm="clr-namespace:BehavePad.ViewModels"
        Title="BehavePad"
        Width="1220"
        Height="820"
        MinWidth="1080"
        MinHeight="680"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        Background="{StaticResource WindowBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="14"
        Foreground="{StaticResource TextPrimaryBrush}"
        Icon="Assets/BehavePad.ico"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource StrokeSubtleBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,18,16,18">
                <StackPanel Margin="6,4,0,28" DockPanel.Dock="Top" Orientation="Horizontal">
                    <Image Width="44" Height="44" Source="{x:Static branding:BrandArt.SmallMarkImage}" />
                    <TextBlock Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource BrandFont}"
                               FontSize="23"
                               FontWeight="SemiBold">
                        <Run Foreground="{StaticResource TextPrimaryBrush}" Text="Behave" /><Run Foreground="{StaticResource AccentBrush}" Text="Pad" />
                    </TextBlock>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Padding="14,12" CornerRadius="14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Filter.IsOn}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <CheckBox Command="{Binding ToggleFilterCommand}" IsChecked="{Binding Filter.IsOn, Mode=OneWay}" Style="{StaticResource SwitchStyle}">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{Binding FilterStatusText}" />
                                <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="for games" />
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <DockPanel Margin="6,14,0,0">
                        <Ellipse Width="8" Height="8" Margin="0,0,9,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource DriftBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Controller.IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <StackPanel>
                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Controller.StatusText}" />
                            <TextBlock FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="{Binding Controller.BatteryText}"
                                       Visibility="{Binding Controller.BatteryText, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>

                <StackPanel>
                    <RadioButton controls:Ui.Glyph="&#xE80F;" Content="Overview" IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Overview}" Style="{StaticResource NavItem}" />
                    <RadioButton controls:Ui.Glyph="&#xE9D9;" Content="Drift test" IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Test}" Style="{StaticResource NavItem}" />
                    <RadioButton controls:Ui.Glyph="&#xE7FC;" Content="Live filter" IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Live}" Style="{StaticResource NavItem}" />
                    <RadioButton controls:Ui.Glyph="&#xE713;" Content="Setup" IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Setup}" Style="{StaticResource NavItem}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Click="OnMinimizeClick" Content="&#xE921;" Style="{StaticResource TitleBarButton}" />
                <Button x:Name="MaximizeButton" Click="OnMaximizeClick" Content="&#xE922;" Style="{StaticResource TitleBarButton}" />
                <Button Click="OnCloseClick" Content="&#xE8BB;" Style="{StaticResource TitleBarCloseButton}" />
            </StackPanel>

            <Border Grid.Row="1"
                    MaxWidth="1040"
                    Margin="36,0,36,0"
                    Padding="16,10"
                    CornerRadius="12"
                    Visibility="{Binding Filter.Message, Converter={StaticResource NullToVisibility}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource InfoSoftBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Filter.MessageIsError}" Value="True">
                                <Setter Property="Background" Value="{StaticResource DriftSoftBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Button Padding="8,4" controls:Ui.Glyph="&#xE711;" Command="{Binding DismissMessageCommand}" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" ToolTip="Dismiss" />
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Filter.Message}" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <ContentControl Grid.Row="2" Content="{Binding CurrentViewModel}" Focusable="False" />
        </Grid>
    </Grid>
</Window>
