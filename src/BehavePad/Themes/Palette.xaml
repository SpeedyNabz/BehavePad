<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <Color x:Key="WindowColor">#0B1016</Color>
    <Color x:Key="SidebarColor">#0E141B</Color>
    <Color x:Key="SurfaceColor">#131B24</Color>
    <Color x:Key="SurfaceRaisedColor">#19232E</Color>
    <Color x:Key="SurfaceHoverColor">#212D3A</Color>
    <Color x:Key="StrokeColor">#26333F</Color>
    <Color x:Key="StrokeSubtleColor">#1B2530</Color>
    <Color x:Key="TrackColor">#2A3847</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#EAF1F7</Color>
    <Color x:Key="TextSecondaryColor">#9AAABB</Color>
    <Color x:Key="TextMutedColor">#7C8FA5</Color>

    <!-- Brand and status -->
    <Color x:Key="AccentColor">#3EE6A8</Color>
    <Color x:Key="AccentHoverColor">#66F1C0</Color>
    <Color x:Key="AccentPressedColor">#2AC990</Color>
    <Color x:Key="OnAccentColor">#05251B</Color>
    <Color x:Key="HaloColor">#FFD166</Color>
    <Color x:Key="DriftColor">#FF6B6B</Color>
    <Color x:Key="WarningColor">#FFA24C</Color>
    <Color x:Key="InfoColor">#5AB0FF</Color>

    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="StrokeSubtleBrush" Color="{StaticResource StrokeSubtleColor}" />
    <SolidColorBrush x:Key="TrackBrush" Color="{StaticResource TrackColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="HaloBrush" Color="{StaticResource HaloColor}" />
    <SolidColorBrush x:Key="DriftBrush" Color="{StaticResource DriftColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />

    <SolidColorBrush x:Key="AccentSoftBrush" Color="#243EE6A8" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#663EE6A8" />
    <SolidColorBrush x:Key="HaloSoftBrush" Color="#24FFD166" />
    <SolidColorBrush x:Key="DriftSoftBrush" Color="#24FF6B6B" />
    <SolidColorBrush x:Key="DriftBorderBrush" Color="#66FF6B6B" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#24FFA24C" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#245AB0FF" />

    <!-- Soft glow that fades out before the shape edge, so no hard outline shows -->
    <RadialGradientBrush x:Key="AccentHazeBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Offset="0" Color="#2E3EE6A8" />
        <GradientStop Offset="0.45" Color="#203EE6A8" />
        <GradientStop Offset="0.75" Color="#103EE6A8" />
        <GradientStop Offset="1" Color="#003EE6A8" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#16222D" />
        <GradientStop Offset="0.55" Color="#121A23" />
        <GradientStop Offset="1" Color="#0F2A22" />
    </LinearGradientBrush>

    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Semibold, Segoe UI</FontFamily>
    <FontFamily x:Key="BrandFont">Bahnschrift SemiBold, Bahnschrift, Segoe UI Semibold</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
</ResourceDictionary>
