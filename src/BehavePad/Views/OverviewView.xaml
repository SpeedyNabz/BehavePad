<UserControl x:Class="BehavePad.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:BehavePad.Controls"
             xmlns:vm="clr-namespace:BehavePad.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:OverviewViewModel}"
             mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1040" Margin="36,28,36,36">

            <!-- Hero -->
            <Border Padding="34,30"
                    Background="{StaticResource HeroBrush}"
                    BorderBrush="{StaticResource StrokeSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <Border Background="{StaticResource AccentSoftBrush}" Style="{StaticResource Pill}" Visibility="{Binding IsFilterOn, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,7,0" Fill="{StaticResource AccentBrush}" />
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="Protecting your games" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceRaisedBrush}" Style="{StaticResource Pill}" Visibility="{Binding IsFilterOn, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,7,0" Fill="{StaticResource TextMutedBrush}" />
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="Filter off" />
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,14,0,0" Style="{StaticResource DisplayText}" Text="{Binding Headline}" />
                        <TextBlock MaxWidth="540"
                                   Margin="0,10,0,0"
                                   HorizontalAlignment="Left"
                                   FontSize="15"
                                   LineHeight="22"
                                   Style="{StaticResource BodyText}"
                                   Text="{Binding Subtext}" />

                        <WrapPanel Margin="0,24,0,0">
                            <Button Margin="0,0,10,8"
                                    controls:Ui.Glyph="{Binding PrimaryGlyph}"
                                    Command="{Binding PrimaryCommand}"
                                    Content="{Binding PrimaryText}"
                                    Style="{StaticResource PrimaryButton}" />
                            <Button Margin="0,0,10,8"
                                    controls:Ui.Glyph="&#xE72C;"
                                    Command="{Binding RunTestCommand}"
                                    Content="Test again"
                                    Style="{StaticResource SecondaryButton}"
                                    Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}" />
                            <Button Margin="0,0,10,8"
                                    controls:Ui.Glyph="&#xE7FC;"
                                    Command="{Binding OpenLiveCommand}"
                                    Content="Live view"
                                    Style="{StaticResource GhostButton}"
                                    Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}" />
                        </WrapPanel>

                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource CaptionText}"
                                   Text="{Binding LastTestedText}"
                                   Visibility="{Binding LastTestedText, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>

                    <controls:PadMascot Grid.Column="1"
                                        Width="236"
                                        Height="236"
                                        Margin="28,0,0,0"
                                        Happy="{Binding MascotHappy}"
                                        HaloOn="{Binding IsFilterOn}"
                                        IsPressed="{Binding AnyPressed}"
                                        LeftStick="{Binding LeftStick}"
                                        LookGain="3"
                                        RightStick="{Binding RightStick}" />
                </Grid>
            </Border>

            <!-- Driver callout -->
            <Border Margin="0,16,0,0"
                    Padding="18,14"
                    Background="{StaticResource InfoSoftBrush}"
                    CornerRadius="14"
                    Visibility="{Binding ShowDriverCallout, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Command="{Binding OpenSetupCommand}"
                            Content="Open setup"
                            DockPanel.Dock="Right"
                            Style="{StaticResource SecondaryButton}" />
                    <TextBlock Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               FontSize="18"
                               Foreground="{StaticResource InfoBrush}"
                               Style="{StaticResource GlyphText}"
                               Text="&#xE946;" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource H3Text}" Text="One-time setup for in-game filtering" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="13"
                                   Style="{StaticResource BodyText}"
                                   Text="Testing and the live preview work now. To clean up input inside games, install two free drivers: ViGEmBus and HidHide." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Health -->
            <TextBlock Margin="0,30,0,12" Style="{StaticResource H2Text}" Text="Controller health" />
            <UniformGrid Columns="4">
                <Border Margin="0,0,9,0" Padding="18" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Border Padding="8,2"
                                    Background="{Binding LeftSeverity, Converter={StaticResource SeverityBrush}, ConverterParameter=soft}"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource Pill}">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding LeftSeverity, Converter={StaticResource SeverityBrush}}" Text="{Binding LeftSeverity, Converter={StaticResource SeverityText}}" />
                            </Border>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource OverlineText}" Text="LEFT STICK" />
                        </DockPanel>
                        <TextBlock Margin="0,12,0,0" Style="{StaticResource H3Text}" Text="{Binding LeftTitle}" />
                        <TextBlock Margin="0,4,0,0" FontSize="13" LineHeight="19" Style="{StaticResource BodyText}" Text="{Binding LeftDetail}" />
                    </StackPanel>
                </Border>

                <Border Margin="3,0,6,0" Padding="18" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Border Padding="8,2"
                                    Background="{Binding RightSeverity, Converter={StaticResource SeverityBrush}, ConverterParameter=soft}"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource Pill}">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding RightSeverity, Converter={StaticResource SeverityBrush}}" Text="{Binding RightSeverity, Converter={StaticResource SeverityText}}" />
                            </Border>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource OverlineText}" Text="RIGHT STICK" />
                        </DockPanel>
                        <TextBlock Margin="0,12,0,0" Style="{StaticResource H3Text}" Text="{Binding RightTitle}" />
                        <TextBlock Margin="0,4,0,0" FontSize="13" LineHeight="19" Style="{StaticResource BodyText}" Text="{Binding RightDetail}" />
                    </StackPanel>
                </Border>

                <Border Margin="6,0,3,0" Padding="18" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Border Padding="8,2"
                                    Background="{Binding TriggerSeverity, Converter={StaticResource SeverityBrush}, ConverterParameter=soft}"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource Pill}">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding TriggerSeverity, Converter={StaticResource SeverityBrush}}" Text="{Binding TriggerSeverity, Converter={StaticResource SeverityText}}" />
                            </Border>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource OverlineText}" Text="TRIGGERS" />
                        </DockPanel>
                        <TextBlock Margin="0,12,0,0" Style="{StaticResource H3Text}" Text="{Binding TriggerTitle}" />
                        <TextBlock Margin="0,4,0,0" FontSize="13" LineHeight="19" Style="{StaticResource BodyText}" Text="{Binding TriggerDetail}" />
                    </StackPanel>
                </Border>

                <Border Margin="9,0,0,0" Padding="18" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Border Padding="8,2"
                                    Background="{Binding ButtonSeverity, Converter={StaticResource SeverityBrush}, ConverterParameter=soft}"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource Pill}">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding ButtonSeverity, Converter={StaticResource SeverityBrush}}" Text="{Binding ButtonSeverity, Converter={StaticResource SeverityText}}" />
                            </Border>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource OverlineText}" Text="BUTTONS" />
                        </DockPanel>
                        <TextBlock Margin="0,12,0,0" Style="{StaticResource H3Text}" Text="{Binding ButtonTitle}" />
                        <TextBlock Margin="0,4,0,0" FontSize="13" LineHeight="19" Style="{StaticResource BodyText}" Text="{Binding ButtonDetail}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Session -->
            <TextBlock Margin="0,30,0,12" Style="{StaticResource H2Text}" Text="This session" />
            <UniformGrid Columns="2">
                <Border Margin="0,0,8,0" Padding="20,18" Style="{StaticResource Card}">
                    <DockPanel>
                        <Border Width="42"
                                Height="42"
                                Margin="0,0,14,0"
                                Background="{StaticResource AccentSoftBrush}"
                                CornerRadius="12">
                            <TextBlock HorizontalAlignment="Center" FontSize="18" Foreground="{StaticResource AccentBrush}" Style="{StaticResource GlyphText}" Text="&#xEA18;" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource MetricText}" Text="{Binding BlockedText}" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="of stick drift kept away from games" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Margin="8,0,0,0" Padding="20,18" Style="{StaticResource Card}">
                    <DockPanel>
                        <Border Width="42"
                                Height="42"
                                Margin="0,0,14,0"
                                Background="{StaticResource HaloSoftBrush}"
                                CornerRadius="12">
                            <TextBlock HorizontalAlignment="Center" FontSize="18" Foreground="{StaticResource HaloBrush}" Style="{StaticResource GlyphText}" Text="&#xE945;" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource MetricText}" Text="{Binding PhantomText}" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="phantom button presses blocked" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
