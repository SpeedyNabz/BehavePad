<UserControl x:Class="BehavePad.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:BehavePad.Controls"
             xmlns:vm="clr-namespace:BehavePad.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:SetupViewModel}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,16" />
            <Setter Property="Background" Value="{StaticResource StrokeSubtleBrush}" />
        </Style>

        <Style x:Key="DriverBadge" TargetType="Border">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="860" Margin="36,28,36,36" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource H1Text}" Text="Setup" />
            <TextBlock Margin="0,6,0,0" Style="{StaticResource BodyText}" Text="Drivers, background behavior and troubleshooting." />

            <Border Margin="0,18,0,0"
                    Padding="16,12"
                    Background="{StaticResource DriftSoftBrush}"
                    CornerRadius="12"
                    Visibility="{Binding XInputMissing, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Foreground="{StaticResource TextPrimaryBrush}" Text="Windows XInput was not found on this PC, so BehavePad is using the demo controller." TextWrapping="Wrap" />
            </Border>

            <!-- Drivers -->
            <DockPanel Margin="0,28,0,12">
                <Button controls:Ui.Glyph="&#xE72C;" Command="{Binding RefreshCommand}" Content="Check again" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" />
                <TextBlock VerticalAlignment="Center" Style="{StaticResource H2Text}" Text="Drivers for in-game filtering" />
            </DockPanel>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Border Style="{StaticResource DriverBadge}">
                            <Grid>
                                <TextBlock HorizontalAlignment="Center" FontSize="18" Foreground="{StaticResource AccentBrush}" Style="{StaticResource GlyphText}" Text="&#xE73E;" Visibility="{Binding Vigem.Ready, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock HorizontalAlignment="Center" FontSize="18" Foreground="{StaticResource WarningBrush}" Style="{StaticResource GlyphText}" Text="&#xE896;" Visibility="{Binding Vigem.Ready, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                            </Grid>
                        </Border>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource H3Text}" Text="ViGEmBus" />
                            <TextBlock Margin="0,2,0,0" FontWeight="SemiBold" Text="{Binding VigemStatus}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Vigem.Ready}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Margin="0,6,0,0" FontSize="13" Style="{StaticResource BodyText}" Text="Creates the clean virtual controller that games read. Required for filtering inside games." />
                        </StackPanel>
                    </DockPanel>

                    <Border Style="{StaticResource Divider}" />

                    <DockPanel>
                        <Border Style="{StaticResource DriverBadge}">
                            <Grid>
                                <TextBlock HorizontalAlignment="Center" FontSize="18" Foreground="{StaticResource AccentBrush}" Style="{StaticResource GlyphText}" Text="&#xE73E;" Visibility="{Binding HidHide.Ready, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock HorizontalAlignment="Center" FontSize="18" Foreground="{StaticResource WarningBrush}" Style="{StaticResource GlyphText}" Text="&#xE896;" Visibility="{Binding HidHide.Ready, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                            </Grid>
                        </Border>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource H3Text}" Text="HidHide" />
                            <TextBlock Margin="0,2,0,0" FontWeight="SemiBold" Text="{Binding HidHideStatus}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HidHide.Ready}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Margin="0,6,0,0" FontSize="13" Style="{StaticResource BodyText}" Text="Hides your worn controller from games so they only see the clean one. Without it, many games read both and the drift comes back." />
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Margin="0,18,0,0">
                        <Button HorizontalAlignment="Left"
                                controls:Ui.Glyph="&#xE896;"
                                Command="{Binding InstallDriversCommand}"
                                Content="{Binding InstallButtonText}"
                                Style="{StaticResource PrimaryButton}"
                                Visibility="{Binding CanInstallDrivers, Converter={StaticResource BoolToVisibility}}" />
                        <ProgressBar Margin="0,14,0,0"
                                     Maximum="1"
                                     Style="{StaticResource ThinProgress}"
                                     Value="{Binding DriverSetup.Progress, Mode=OneWay}"
                                     Visibility="{Binding DriverSetup.IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Margin="0,10,0,0"
                                   FontWeight="SemiBold"
                                   Text="{Binding DriverSetup.Status}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding DriverSetup.Status, Converter={StaticResource NullToVisibility}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DriverSetup.StatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource DriftBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Margin="0,16,0,0" Style="{StaticResource CaptionText}">
                        <Run Text="Both drivers are free and open source from Nefarius Software Solutions. BehavePad downloads the official installers, checks that each one is exactly the file it expects, and installs them after Windows asks for permission once. Restart your PC if asked. To install them yourself, download" />
                        <Hyperlink Command="{Binding OpenVigemDownloadCommand}" Foreground="{StaticResource AccentBrush}">ViGEmBus</Hyperlink>
                        <Run Text="and" />
                        <Hyperlink Command="{Binding OpenHidHideDownloadCommand}" Foreground="{StaticResource AccentBrush}">HidHide</Hyperlink><Run Text="." />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Behavior -->
            <TextBlock Margin="0,30,0,12" Style="{StaticResource H2Text}" Text="Behavior" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox IsChecked="{Binding HidePhysicalController}" Style="{StaticResource SwitchStyle}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Hide my controller from games while filtering" />
                            <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionText}" Text="Games only see BehavePad's clean controller. Windows asks for permission each time, unless BehavePad runs as administrator. Your controller becomes visible again when the filter turns off." />
                        </StackPanel>
                    </CheckBox>
                    <Border Style="{StaticResource Divider}" />
                    <CheckBox IsChecked="{Binding MinimizeToTray}" Style="{StaticResource SwitchStyle}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Keep filtering after closing the window" />
                            <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionText}" Text="BehavePad stays in the notification area while the filter is on." />
                        </StackPanel>
                    </CheckBox>
                    <Border Style="{StaticResource Divider}" />
                    <CheckBox IsChecked="{Binding StartFilterOnLaunch}" Style="{StaticResource SwitchStyle}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Turn the filter on when BehavePad starts" />
                            <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionText}" Text="Uses your saved filter automatically." />
                        </StackPanel>
                    </CheckBox>
                    <Border Style="{StaticResource Divider}" />
                    <CheckBox IsChecked="{Binding LaunchAtSignIn}" Style="{StaticResource SwitchStyle}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Start BehavePad when I sign in" />
                            <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionText}" Text="Opens quietly in the notification area." />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Controller -->
            <TextBlock Margin="0,30,0,12" Style="{StaticResource H2Text}" Text="Controller" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Which controller to read" />
                    <TextBlock Margin="0,3,0,12" Style="{StaticResource CaptionText}" Text="Automatic picks the first connected controller. Choose a number if several are plugged in." />
                    <Border Style="{StaticResource SegmentHost}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Automatic" IsChecked="{Binding PreferredSlot, Converter={StaticResource EnumEquals}, ConverterParameter=-1}" Style="{StaticResource SegmentItem}" />
                            <RadioButton Content="1" IsChecked="{Binding PreferredSlot, Converter={StaticResource EnumEquals}, ConverterParameter=0}" Style="{StaticResource SegmentItem}" />
                            <RadioButton Content="2" IsChecked="{Binding PreferredSlot, Converter={StaticResource EnumEquals}, ConverterParameter=1}" Style="{StaticResource SegmentItem}" />
                            <RadioButton Content="3" IsChecked="{Binding PreferredSlot, Converter={StaticResource EnumEquals}, ConverterParameter=2}" Style="{StaticResource SegmentItem}" />
                            <RadioButton Content="4" IsChecked="{Binding PreferredSlot, Converter={StaticResource EnumEquals}, ConverterParameter=3}" Style="{StaticResource SegmentItem}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Divider}" />
                    <CheckBox IsChecked="{Binding UseDemoController}" Style="{StaticResource SwitchStyle}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Use the demo controller" />
                            <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionText}" Text="Try BehavePad without hardware. The demo controller has right stick drift, a creeping left trigger and a Y button that presses itself." />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Troubleshooting -->
            <TextBlock Margin="0,30,0,12" Style="{StaticResource H2Text}" Text="Troubleshooting" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Button VerticalAlignment="Center" Command="{Binding RestoreVisibilityCommand}" Content="Restore" DockPanel.Dock="Right" Style="{StaticResource DangerButton}" />
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock FontWeight="SemiBold" Text="Restore controller visibility" />
                            <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionText}" Text="If a game can't see your controller after BehavePad closed unexpectedly, this makes it visible again." />
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource WarningBrush}"
                                       Text="BehavePad is currently hiding a controller."
                                       Visibility="{Binding HasPendingRestore, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel>
                        <Button VerticalAlignment="Center"
                                controls:Ui.Glyph="&#xE7EF;"
                                Command="{Binding RestartAsAdministratorCommand}"
                                Content="Restart as administrator"
                                DockPanel.Dock="Right"
                                Style="{StaticResource SecondaryButton}"
                                Visibility="{Binding IsElevated, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                        <TextBlock VerticalAlignment="Center"
                                   DockPanel.Dock="Right"
                                   Foreground="{StaticResource AccentBrush}"
                                   Text="Running as administrator"
                                   Visibility="{Binding IsElevated, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock FontWeight="SemiBold" Text="Fewer permission prompts" />
                            <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionText}" Text="Running as administrator lets BehavePad hide and restore your controller without asking each time." />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel>
                        <Button VerticalAlignment="Center" Command="{Binding ResetProfileCommand}" Content="Delete" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" />
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock FontWeight="SemiBold" Text="Delete test results and filter" />
                            <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionText}" Text="Start fresh, for example after replacing a thumbstick." />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel>
                        <Button VerticalAlignment="Center" controls:Ui.Glyph="&#xE838;" Command="{Binding OpenDataFolderCommand}" Content="Open" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" />
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock FontWeight="SemiBold" Text="Data folder" />
                            <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionText}" Text="{Binding DataFolder}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Updates -->
            <TextBlock Margin="0,30,0,12" Style="{StaticResource H2Text}" Text="Updates" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox IsChecked="{Binding AutomaticUpdates}" Style="{StaticResource SwitchStyle}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Keep BehavePad up to date" />
                            <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionText}" Text="Checks once a day, downloads the new release in the background, and installs it the next time you exit BehavePad. Your settings, last test and filter are kept." />
                        </StackPanel>
                    </CheckBox>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel>
                        <Button VerticalAlignment="Center"
                                controls:Ui.Glyph="&#xE72C;"
                                Command="{Binding CheckForUpdatesCommand}"
                                Content="Check now"
                                DockPanel.Dock="Right"
                                Style="{StaticResource GhostButton}" />
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock FontWeight="SemiBold" Text="{Binding VersionText}" />
                            <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionText}">
                                <Run Text="Updates come from BehavePad's" />
                                <Hyperlink Command="{Binding OpenReleasePageCommand}" Foreground="{StaticResource AccentBrush}">GitHub releases</Hyperlink><Run Text=". Every download has to match the checksum GitHub published before BehavePad will run it." />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Margin="0,4,0,0">
                        <Button Margin="0,14,0,0"
                                HorizontalAlignment="Left"
                                controls:Ui.Glyph="&#xE777;"
                                Command="{Binding InstallUpdateCommand}"
                                Content="Restart and install"
                                Style="{StaticResource PrimaryButton}"
                                Visibility="{Binding Update.IsReady, Converter={StaticResource BoolToVisibility}}" />
                        <ProgressBar Margin="0,14,0,0"
                                     Maximum="1"
                                     Style="{StaticResource ThinProgress}"
                                     Value="{Binding Update.Progress, Mode=OneWay}"
                                     Visibility="{Binding Update.IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Margin="0,10,0,0"
                                   FontWeight="SemiBold"
                                   Text="{Binding Update.Status}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding Update.Status, Converter={StaticResource NullToVisibility}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Update.StatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource DriftBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
