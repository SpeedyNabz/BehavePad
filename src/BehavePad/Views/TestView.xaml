<UserControl x:Class="BehavePad.Views.TestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:BehavePad.Controls"
             xmlns:vm="clr-namespace:BehavePad.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:TestViewModel}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="StepChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="5,5,14,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource TextMutedBrush}" />
        </Style>

        <Style x:Key="StepDot" TargetType="Border">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
        </Style>

        <Style x:Key="TipNumber" TargetType="Border">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1040" Margin="36,28,36,36">

            <!-- Header and stepper -->
            <DockPanel>
                <StackPanel VerticalAlignment="Center" DockPanel.Dock="Right" Orientation="Horizontal">
                    <Border>
                        <Border.Style>
                            <Style BasedOn="{StaticResource StepChip}" TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Step}" Value="Intro">
                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Step}" Value="Countdown">
                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Step}" Value="Resting">
                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Step}" Value="SnapBack">
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Step}" Value="Results">
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource StepDot}">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="1" />
                            </Border>
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="Rest check" />
                        </StackPanel>
                    </Border>

                    <Border>
                        <Border.Style>
                            <Style BasedOn="{StaticResource StepChip}" TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Step}" Value="SnapBack">
                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Step}" Value="Results">
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource StepDot}">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="2" />
                            </Border>
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="Snap-back" />
                        </StackPanel>
                    </Border>

                    <Border>
                        <Border.Style>
                            <Style BasedOn="{StaticResource StepChip}" TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Step}" Value="Results">
                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource StepDot}">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="3" />
                            </Border>
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="Your filter" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel>
                    <TextBlock Style="{StaticResource H1Text}" Text="Drift test" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource BodyText}" Text="BehavePad listens while nobody touches the controller, then checks how the sticks spring back." />
                </StackPanel>
            </DockPanel>

            <!-- Notice -->
            <Border Margin="0,18,0,0"
                    Padding="16,12"
                    Background="{StaticResource WarningSoftBrush}"
                    CornerRadius="12"
                    Visibility="{Binding Notice, Converter={StaticResource NullToVisibility}}">
                <DockPanel>
                    <TextBlock Margin="0,0,10,0" Foreground="{StaticResource WarningBrush}" Style="{StaticResource GlyphText}" Text="&#xE7BA;" />
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding Notice}" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!-- Step: intro -->
            <Border Margin="0,18,0,0"
                    Padding="30"
                    Style="{StaticResource Card}"
                    Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Intro}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="260" Height="250" VerticalAlignment="Center">
                        <Ellipse Width="220"
                                 Height="22"
                                 Margin="0,0,0,30"
                                 VerticalAlignment="Bottom"
                                 Fill="#070B10" />
                        <Border Height="5"
                                Margin="0,0,0,38"
                                VerticalAlignment="Bottom"
                                Background="{StaticResource StrokeBrush}"
                                CornerRadius="3" />
                        <controls:PadMascot Width="200"
                                            Height="200"
                                            Margin="0,0,0,12"
                                            VerticalAlignment="Bottom"
                                            HaloOn="True"
                                            LeftStick="{Binding LeftRaw}"
                                            LookGain="3"
                                            RightStick="{Binding RightRaw}" />
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="26,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource H2Text}" Text="Set your controller down and let go" />
                        <TextBlock Margin="0,6,0,18" Style="{StaticResource BodyText}" Text="Stick drift and phantom presses only show up when nobody is touching the controller." />

                        <DockPanel Margin="0,0,0,12">
                            <Border Style="{StaticResource TipNumber}">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="1" />
                            </Border>
                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Text="Lay it face up on a desk or table." TextWrapping="Wrap" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Border Style="{StaticResource TipNumber}">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="2" />
                            </Border>
                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Text="Take your hands off the sticks, triggers and buttons." TextWrapping="Wrap" />
                        </DockPanel>
                        <DockPanel>
                            <Border Style="{StaticResource TipNumber}">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="3" />
                            </Border>
                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Text="Keep it connected. Wired and wireless both work." TextWrapping="Wrap" />
                        </DockPanel>

                        <TextBlock Margin="0,24,0,8" Style="{StaticResource OverlineText}" Text="TEST LENGTH" />
                        <Border Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Quick · 6 s" IsChecked="{Binding Length, Converter={StaticResource EnumEquals}, ConverterParameter=Quick}" Style="{StaticResource SegmentItem}" />
                                <RadioButton Content="Standard · 10 s" IsChecked="{Binding Length, Converter={StaticResource EnumEquals}, ConverterParameter=Standard}" Style="{StaticResource SegmentItem}" />
                                <RadioButton Content="Thorough · 20 s" IsChecked="{Binding Length, Converter={StaticResource EnumEquals}, ConverterParameter=Thorough}" Style="{StaticResource SegmentItem}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="0,26,0,0" Orientation="Horizontal">
                            <Button controls:Ui.Glyph="&#xE768;"
                                    Command="{Binding BeginCommand}"
                                    Content="Start rest check"
                                    Style="{StaticResource PrimaryButton}" />
                            <TextBlock Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionText}"
                                       Text="Connect a controller to begin."
                                       Visibility="{Binding CanBegin, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Step: countdown -->
            <Border Margin="0,18,0,0"
                    Padding="30,36"
                    Style="{StaticResource Card}"
                    Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Countdown}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="110"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"
                               Text="{Binding Countdown}" />
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource H2Text}" Text="Hands off the controller" />
                    <TextBlock Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               Style="{StaticResource BodyText}"
                               Text="The rest check starts in a moment. Leave it lying flat."
                               TextAlignment="Center" />
                    <Button Margin="0,22,0,0"
                            HorizontalAlignment="Center"
                            Command="{Binding CancelCommand}"
                            Content="Cancel"
                            Style="{StaticResource GhostButton}" />
                </StackPanel>
            </Border>

            <!-- Step: resting -->
            <Border Margin="0,18,0,0"
                    Padding="28"
                    Style="{StaticResource Card}"
                    Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Resting}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <Grid Width="196" Height="196">
                            <controls:ProgressRing Progress="{Binding RestProgress}" Thickness="10" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center" FontSize="54" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding RestRemaining}" />
                                <TextBlock HorizontalAlignment="Center" Style="{StaticResource CaptionText}" Text="seconds left" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,18,0,0" HorizontalAlignment="Center" Style="{StaticResource H3Text}" Text="Listening for unintended input" />
                        <TextBlock Margin="0,4,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource CaptionText}"
                                   Text="Keep your hands off until the ring fills."
                                   TextAlignment="Center" />
                        <Button Margin="0,16,0,0"
                                HorizontalAlignment="Center"
                                Command="{Binding CancelCommand}"
                                Content="Cancel"
                                Style="{StaticResource GhostButton}" />
                    </StackPanel>

                    <Grid Grid.Column="1" Margin="24,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource OverlineText}" Text="LEFT STICK" />
                            <controls:StickPlot Height="210"
                                                Margin="0,10,0,0"
                                                Outline="{Binding LeftLiveOutline}"
                                                OutlineMargin="{Binding LiveOutlineMargin}"
                                                RawPoint="{Binding LeftRaw}"
                                                RestPoints="{Binding LeftCloudPoints}"
                                                ShowTrail="False"
                                                Zoom="{Binding LeftLiveZoom}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Style="{StaticResource OverlineText}" Text="RIGHT STICK" />
                            <controls:StickPlot Height="210"
                                                Margin="0,10,0,0"
                                                Outline="{Binding RightLiveOutline}"
                                                OutlineMargin="{Binding LiveOutlineMargin}"
                                                RawPoint="{Binding RightRaw}"
                                                RestPoints="{Binding RightCloudPoints}"
                                                ShowTrail="False"
                                                Zoom="{Binding RightLiveZoom}" />
                        </StackPanel>

                        <TextBlock Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Margin="0,10,0,0"
                                   Style="{StaticResource CaptionText}"
                                   Text="The dashed outline stretches to cover every spot each stick drifts to. You can use it as a shaped ignore zone."
                                   TextAlignment="Center" />

                        <StackPanel Grid.Row="2" Margin="0,20,12,0">
                            <TextBlock Margin="0,0,0,8" Style="{StaticResource OverlineText}" Text="LEFT TRIGGER" />
                            <controls:TriggerBar RawValue="{Binding LeftTrigger}" ShowOutput="False" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="12,20,0,0">
                            <TextBlock Margin="0,0,0,8" Style="{StaticResource OverlineText}" Text="RIGHT TRIGGER" />
                            <controls:TriggerBar RawValue="{Binding RightTrigger}" ShowOutput="False" />
                        </StackPanel>

                        <Border Grid.Row="3"
                                Grid.ColumnSpan="2"
                                Margin="0,20,0,0"
                                Padding="16,11"
                                Style="{StaticResource InsetCard}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding PhantomPresses}" />
                                <TextBlock Style="{StaticResource BodyText}" Text="Phantom button presses so far" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Step: snap-back -->
            <Border Margin="0,18,0,0"
                    Padding="28"
                    Style="{StaticResource Card}"
                    Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=SnapBack}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2Text}" Text="Now push each stick to the edge and let go" />
                    <TextBlock MaxWidth="720"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Left"
                               Style="{StaticResource BodyText}"
                               Text="Let the stick spring back on its own. Do it six times per stick, in different directions. Worn springs land in a slightly different spot each time, and BehavePad measures that. Both sticks can go at once." />

                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <DockPanel>
                                <TextBlock VerticalAlignment="Center" DockPanel.Dock="Right" Style="{StaticResource CaptionText}">
                                    <Run Text="{Binding LeftReleases, Mode=OneWay}" /><Run Text=" of " /><Run Text="{Binding ReleaseTarget, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource OverlineText}" Text="LEFT STICK" />
                            </DockPanel>
                            <controls:StickPlot Height="230" Margin="0,10,0,0" Outline="{Binding LeftLiveOutline}" OutlineMargin="{Binding LiveOutlineMargin}" RawPoint="{Binding LeftRaw}" SettlePoints="{Binding LeftSettles}" />
                            <ProgressBar Margin="0,16,0,0" Maximum="{Binding ReleaseTarget, Mode=OneWay}" Style="{StaticResource ThinProgress}" Value="{Binding LeftReleases, Mode=OneWay}" />
                            <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}" Style="{StaticResource H3Text}" Text="{Binding LeftHint}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <DockPanel>
                                <TextBlock VerticalAlignment="Center" DockPanel.Dock="Right" Style="{StaticResource CaptionText}">
                                    <Run Text="{Binding RightReleases, Mode=OneWay}" /><Run Text=" of " /><Run Text="{Binding ReleaseTarget, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource OverlineText}" Text="RIGHT STICK" />
                            </DockPanel>
                            <controls:StickPlot Height="230" Margin="0,10,0,0" Outline="{Binding RightLiveOutline}" OutlineMargin="{Binding LiveOutlineMargin}" RawPoint="{Binding RightRaw}" SettlePoints="{Binding RightSettles}" />
                            <ProgressBar Margin="0,16,0,0" Maximum="{Binding ReleaseTarget, Mode=OneWay}" Style="{StaticResource ThinProgress}" Value="{Binding RightReleases, Mode=OneWay}" />
                            <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}" Style="{StaticResource H3Text}" Text="{Binding RightHint}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,22,0,0" Orientation="Horizontal">
                        <Button Command="{Binding SkipSnapBackCommand}" Content="Skip this step" Style="{StaticResource SecondaryButton}" />
                        <Button Margin="10,0,0,0" Command="{Binding CancelCommand}" Content="Cancel" Style="{StaticResource GhostButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Step: results -->
            <StackPanel Margin="0,18,0,0" Visibility="{Binding Step, Converter={StaticResource EnumToVisibility}, ConverterParameter=Results}">
                <Border Padding="22,18"
                        Background="{Binding OverallSeverity, Converter={StaticResource SeverityBrush}, ConverterParameter=soft}"
                        BorderBrush="{Binding OverallSeverity, Converter={StaticResource SeverityBrush}}"
                        BorderThickness="1"
                        CornerRadius="16">
                    <DockPanel>
                        <Border Width="44"
                                Height="44"
                                Margin="0,0,16,0"
                                VerticalAlignment="Top"
                                Background="{Binding OverallSeverity, Converter={StaticResource SeverityBrush}}"
                                CornerRadius="22">
                            <TextBlock HorizontalAlignment="Center" FontSize="20" Foreground="{StaticResource OnAccentBrush}" Style="{StaticResource GlyphText}" Text="&#xE9D9;" />
                        </Border>
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2Text}" Text="{Binding VerdictTitle}" />
                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextPrimaryBrush}" Opacity="0.85" Style="{StaticResource BodyText}" Text="{Binding VerdictBody}" />
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Style="{StaticResource CaptionText}"
                                       Text="{Binding SnapSkippedNote}"
                                       Visibility="{Binding SnapSkippedNote, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:StickPlot Width="164"
                                                Height="164"
                                                VerticalAlignment="Top"
                                                Center="{Binding LeftCenter}"
                                                Deadzone="{Binding LeftDeadzone}"
                                                Outline="{Binding LeftOutline}"
                                                OutlineMargin="{Binding LeftOutlineMargin}"
                                                RestPoints="{Binding Report.LeftStick.RestPoints}"
                                                SettlePoints="{Binding Report.LeftStick.SettlePoints}"
                                                ShowRaw="False"
                                                Zoom="{Binding LeftResultZoom}" />
                            <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                <DockPanel>
                                    <Border Padding="8,2" Background="{Binding LeftSeverity, Converter={StaticResource SeverityBrush}, ConverterParameter=soft}" DockPanel.Dock="Right" Style="{StaticResource Pill}">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding LeftSeverity, Converter={StaticResource SeverityBrush}}" Text="{Binding LeftSeverity, Converter={StaticResource SeverityText}}" />
                                    </Border>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource OverlineText}" Text="LEFT STICK" />
                                </DockPanel>
                                <TextBlock Margin="0,10,0,0" Style="{StaticResource H3Text}" Text="{Binding LeftTitle}" />
                                <TextBlock Margin="0,4,0,0" FontSize="13" LineHeight="19" Style="{StaticResource BodyText}" Text="{Binding LeftDetail}" />
                                <DockPanel Margin="0,12,0,0">
                                    <TextBlock Margin="0,2,8,0" VerticalAlignment="Top" FontSize="13" Foreground="{StaticResource AccentBrush}" Style="{StaticResource GlyphText}" Text="&#xEA18;" />
                                    <TextBlock FontSize="13" Foreground="{StaticResource AccentBrush}" Style="{StaticResource BodyText}" Text="{Binding LeftFilterText}" />
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:StickPlot Width="164"
                                                Height="164"
                                                VerticalAlignment="Top"
                                                Center="{Binding RightCenter}"
                                                Deadzone="{Binding RightDeadzone}"
                                                Outline="{Binding RightOutline}"
                                                OutlineMargin="{Binding RightOutlineMargin}"
                                                RestPoints="{Binding Report.RightStick.RestPoints}"
                                                SettlePoints="{Binding Report.RightStick.SettlePoints}"
                                                ShowRaw="False"
                                                Zoom="{Binding RightResultZoom}" />
                            <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                <DockPanel>
                                    <Border Padding="8,2" Background="{Binding RightSeverity, Converter={StaticResource SeverityBrush}, ConverterParameter=soft}" DockPanel.Dock="Right" Style="{StaticResource Pill}">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding RightSeverity, Converter={StaticResource SeverityBrush}}" Text="{Binding RightSeverity, Converter={StaticResource SeverityText}}" />
                                    </Border>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource OverlineText}" Text="RIGHT STICK" />
                                </DockPanel>
                                <TextBlock Margin="0,10,0,0" Style="{StaticResource H3Text}" Text="{Binding RightTitle}" />
                                <TextBlock Margin="0,4,0,0" FontSize="13" LineHeight="19" Style="{StaticResource BodyText}" Text="{Binding RightDetail}" />
                                <DockPanel Margin="0,12,0,0">
                                    <TextBlock Margin="0,2,8,0" VerticalAlignment="Top" FontSize="13" Foreground="{StaticResource AccentBrush}" Style="{StaticResource GlyphText}" Text="&#xEA18;" />
                                    <TextBlock FontSize="13" Foreground="{StaticResource AccentBrush}" Style="{StaticResource BodyText}" Text="{Binding RightFilterText}" />
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <WrapPanel Margin="6,12,0,0">
                    <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{StaticResource DriftBrush}" />
                    <TextBlock Margin="0,0,18,0" Style="{StaticResource CaptionText}" Text="Where the stick sat untouched" />
                    <Ellipse Width="9" Height="9" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{StaticResource HaloBrush}" />
                    <TextBlock Margin="0,0,18,0" Style="{StaticResource CaptionText}" Text="Where it sprang back to" />
                    <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{StaticResource AccentSoftBrush}" Stroke="{StaticResource AccentBrush}" StrokeDashArray="2,1.5" />
                    <TextBlock Style="{StaticResource CaptionText}" Text="Area the filter ignores" />
                </WrapPanel>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Border Padding="8,2" Background="{Binding TriggerSeverity, Converter={StaticResource SeverityBrush}, ConverterParameter=soft}" DockPanel.Dock="Right" Style="{StaticResource Pill}">
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding TriggerSeverity, Converter={StaticResource SeverityBrush}}" Text="{Binding TriggerSeverity, Converter={StaticResource SeverityText}}" />
                                </Border>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource OverlineText}" Text="TRIGGERS" />
                            </DockPanel>
                            <TextBlock Margin="0,10,0,0" Style="{StaticResource H3Text}" Text="{Binding TriggerTitle}" />
                            <TextBlock Margin="0,4,0,0" FontSize="13" Style="{StaticResource BodyText}" Text="{Binding TriggerDetail}" />
                            <TextBlock Margin="0,10,0,0" FontSize="13" Foreground="{StaticResource AccentBrush}" Style="{StaticResource BodyText}" Text="{Binding TriggerFilterText}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Border Padding="8,2" Background="{Binding ButtonSeverity, Converter={StaticResource SeverityBrush}, ConverterParameter=soft}" DockPanel.Dock="Right" Style="{StaticResource Pill}">
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding ButtonSeverity, Converter={StaticResource SeverityBrush}}" Text="{Binding ButtonSeverity, Converter={StaticResource SeverityText}}" />
                                </Border>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource OverlineText}" Text="BUTTONS" />
                            </DockPanel>
                            <TextBlock Margin="0,10,0,0" Style="{StaticResource H3Text}" Text="{Binding ButtonTitle}" />
                            <TextBlock Margin="0,4,0,0" FontSize="13" Style="{StaticResource BodyText}" Text="{Binding ButtonDetail}" />
                            <TextBlock Margin="0,10,0,0" FontSize="13" Foreground="{StaticResource AccentBrush}" Style="{StaticResource BodyText}" Text="{Binding ButtonFilterText}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Margin="0,16,0,0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H3Text}" Text="Ignore zone shape" />
                        <TextBlock Margin="0,4,0,14" Style="{StaticResource CaptionText}" Text="Both shapes use the same measurements. You can switch later in the live view." />
                        <UniformGrid Columns="2">
                            <RadioButton Margin="0,0,6,0" IsChecked="{Binding ZoneShape, Converter={StaticResource EnumEquals}, ConverterParameter=Circle}" Style="{StaticResource ChoiceCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H3Text}" Text="Round" />
                                    <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionText}" Text="{Binding CircleShapeCost}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Margin="6,0,0,0" IsChecked="{Binding ZoneShape, Converter={StaticResource EnumEquals}, ConverterParameter=Fitted}" Style="{StaticResource ChoiceCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H3Text}" Text="Shaped to drift" />
                                    <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionText}" Text="{Binding FittedShapeCost}" />
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>
                        <TextBlock Margin="0,12,0,0" FontSize="13" Style="{StaticResource BodyText}" Text="{Binding ShapeDescription}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H3Text}" Text="How much protection?" />
                        <TextBlock Margin="0,4,0,14" Style="{StaticResource CaptionText}" Text="You can fine-tune this later in the live view." />
                        <UniformGrid Columns="3">
                            <RadioButton Margin="0,0,8,0" IsChecked="{Binding Level, Converter={StaticResource EnumEquals}, ConverterParameter=Precise}" Style="{StaticResource ChoiceCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H3Text}" Text="Precise" />
                                    <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionText}" Text="Sharpest aim" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Margin="4,0" IsChecked="{Binding Level, Converter={StaticResource EnumEquals}, ConverterParameter=Balanced}" Style="{StaticResource ChoiceCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H3Text}" Text="Balanced" />
                                    <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionText}" Text="Recommended" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Margin="8,0,0,0" IsChecked="{Binding Level, Converter={StaticResource EnumEquals}, ConverterParameter=Maximum}" Style="{StaticResource ChoiceCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H3Text}" Text="Maximum" />
                                    <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionText}" Text="Most drift protection" />
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>
                        <TextBlock Margin="0,12,0,0" FontSize="13" Style="{StaticResource BodyText}" Text="{Binding LevelDescription}" />
                    </StackPanel>
                </Border>

                <WrapPanel Margin="0,20,0,0">
                    <Button Margin="0,0,10,8" controls:Ui.Glyph="&#xEA18;" Command="{Binding SaveAndEnableCommand}" Content="Save and turn on" Style="{StaticResource PrimaryButton}" />
                    <Button Margin="0,0,10,8" Command="{Binding SaveOnlyCommand}" Content="Save filter only" Style="{StaticResource SecondaryButton}" />
                    <Button Margin="0,0,10,8" controls:Ui.Glyph="&#xE72C;" Command="{Binding RunAgainCommand}" Content="Test again" Style="{StaticResource GhostButton}" />
                </WrapPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
